# EmailJS Configuration
# Replace these with your actual keys from the EmailJS dashboard (https://dashboard.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Backend Production API URL (e.g. https://your-spring-boot-backend.onrender.com)
# Leave blank or omit for localhost:8080 fallback
VITE_API_URL=your_backend_api_url_here
